# OpsHive 环境变量示例 —— 复制为 .env 并填入真实值，.env 永不入库

# ---- 控制平面 ----
# 监听地址（默认 :8080）
OPSHIVE_ADDR=:8080
# CORS 白名单（逗号分隔，开发期 Vite 默认已含 localhost:5173）
OPSHIVE_CORS_ORIGINS=http://localhost:5173

# ---- AI 诊断（headless-agent）----
# LLM 提供方（OpenAI 兼容，默认取本机 hermes 配置）
# GOODPUTAI_API_KEY=your-key-here
# GOODPUTAI_BASE_URL=https://api.goodputai.cn/v1
# 诊断模型（默认 z-ai/glm-5.2）
# OPSHIVE_LLM_MODEL=z-ai/glm-5.2
# diagnose.py 路径（控制平面子进程调用）
# OPSHIVE_DIAGNOSE_SCRIPT=../headless-agent/diagnose.py

# ---- 阿里云（只读数据源，经 aliyun CLI）----
# 通过环境变量传给 aliyun CLI；或 aliyun configure 配置
# ALIBABA_CLOUD_ACCESS_KEY_ID=your-ak
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-sk
# 只读 RAM 策略建议：AliyunLogReadOnlyAccess

# ---- 前端 ----
# console/.env 或启动时注入
# VITE_API_MODE=http            # mock | http
# VITE_API_BASE=http://localhost:8081

# ---- Agent Swarms（内部多智能体运行时）----
# 参考 samson-samson/claude-code fork：
# CLAUDE_CODE_COORDINATOR_MODE=1
# 团队目录默认 ~/.claude/teams/{teamName}/
